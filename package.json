{
  "name": "curiosity-institute",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Playable SvelteKit museum game built from concept art, splat rooms, and Google-generated 3D-style map renders.",
  "scripts": {
    "app:sync": "node scripts/sync-game-assets.js",
    "predev": "npm run app:sync",
    "dev": "vite dev",
    "prebuild": "npm run app:sync",
    "build": "vite build",
    "prepreview": "npm run app:sync",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "precheck": "npm run app:sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "curriculum:generate": "node scripts/generate-year6-curriculum.js",
    "game": "npm run dev",
    "game:data": "node scripts/build-game-data.js",
    "splats": "node scripts/render-room-splats.js",
    "splats:dry": "node scripts/render-room-splats.js --dry-run",
    "splats:rebuild": "node scripts/rebuild-photosphere-textures.js",
    "photospheres": "node scripts/render-room-photospheres.js",
    "photospheres:dry": "node scripts/render-room-photospheres.js --dry-run",
    "photospheres:rebuild": "node scripts/rebuild-photosphere-textures.js",
    "render": "node scripts/render-concept-art-3d.js",
    "render:dry": "node scripts/render-concept-art-3d.js --dry-run --allow-empty",
    "test": "node --test"
  },
  "dependencies": {
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^5.10.2",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.5.2",
    "@types/three": "^0.180.0",
    "svelte": "^5.54.0",
    "svelte-check": "^4.4.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  }
}
