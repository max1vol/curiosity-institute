GEMINI_API_KEY=your_gemini_api_key_here

# Primary model selection. Override this if you want a different preview or dev build.
GEMINI_MODEL=gemini-3-pro-image-preview

# Optional alias if you prefer Google's older env naming.
# GOOGLE_IMAGE_MODEL=gemini-3-pro-image-preview

# Optional Vertex AI mode instead of GEMINI_API_KEY:
# GOOGLE_ACCESS_TOKEN=your_vertex_access_token_here
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

INPUT_DIR=docs/concept-art
OUTPUT_DIR=output/renders
REPORTS_DIR=output/reports
RETRY_LIMIT=3
