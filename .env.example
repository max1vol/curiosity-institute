GEMINI_API_KEY=your_gemini_api_key_here

# Primary model selection. Override this if you want a different preview or dev build.
GEMINI_MODEL=gemini-3-pro-image-preview

# Optional shell-style key file. If set, the pipeline will load variables from it
# after reading .env. Useful for shared local secrets files outside the repo.
# KEYS_FILE=/absolute/path/to/keys.txt

# Optional auth preference. Supported values:
# auto | service-account | vertex-access-token | developer-api
# GOOGLE_AUTH_MODE=service-account

# Optional alias if you prefer Google's older env naming.
# GOOGLE_IMAGE_MODEL=gemini-3-pro-image-preview

# Optional Vertex AI mode instead of GEMINI_API_KEY:
# GOOGLE_SERVICE_ACCOUNT_JSON='{"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}'
# GOOGLE_ACCESS_TOKEN=your_vertex_access_token_here
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

INPUT_DIR=docs/concept-art
OUTPUT_DIR=output/renders
REPORTS_DIR=output/reports
RETRY_LIMIT=3
