GEMINI_API_KEY=your_api_key_here
# Optional Vertex AI fallback instead of GEMINI_API_KEY:
# GOOGLE_ACCESS_TOKEN=your_vertex_access_token_here
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Stable default. If your account has preview access, you can switch to:
# GOOGLE_IMAGE_MODEL=gemini-3-pro-image-preview
GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image

INPUT_DIR=input/concept-art
OUTPUT_DIR=output/renders
REPORTS_DIR=output/reports
RETRY_LIMIT=3
